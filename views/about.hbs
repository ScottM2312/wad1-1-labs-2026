{{> menu id="about"}}

<section class="ui left aligned middle aligned segment">
  
  <h2>Playlist App Dashboard</h2>
<div class="ui centered link cards">

  {{#each employees}}
  <div class = "ui card">
  <div class="image">
    <img src="{{image}}">
  </div>
  <div class="content">
    <a class="header">{{fullname}}</a>
    <div class="meta">
      <span class="date">Joined in 2016</span>
    </div>
    <div class="description">
      Stevie is an Web Developer living in Boston.
    </div>
  </div>
  <div class="extra content">
    <a>
      <i class="user icon"></i>
      35 contacts
    </a>
  </div>
</div>
  {{/each}}
  </div>
</section>